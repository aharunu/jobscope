# ==============================================================================
# JobScope Environment Configuration Template (.env.example)
#
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# DO NOT store real production secrets or credentials in this file or commit .env!
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=JobScope
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# Server Network Binding
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL with asyncpg driver)
# ------------------------------------------------------------------------------
# Pattern: postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql+asyncpg://jobscope:CHANGE_ME@localhost:5432/jobscope

# Shared PostgreSQL credentials (legacy native DB helper and full Compose).
# Full Compose publishes its separate database on DOCKER_POSTGRES_PORT (5433),
# regardless of POSTGRES_PORT below. See .env.docker.example for isolated config.
POSTGRES_DB=jobscope
POSTGRES_USER=jobscope
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_PORT=5432

# Full-stack Docker AI uses DOCKER_AI_* overrides and defaults to disabled.
# Native AI_* settings below remain unchanged; see .env.docker.example.

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: console (human-readable) or json (machine-readable structured logging)
LOG_FORMAT=console

# Optional explicit AI analysis (disabled by default; never commit a real key).
AI_ENABLED=false
OPENAI_API_KEY=
AI_MODEL=gpt-4.1-mini-2025-04-14
AI_TIMEOUT_SECONDS=30
# Optional OpenAI-compatible API base (including /v1); blank keeps hosted OpenAI.
AI_BASE_URL=
# Local LM Studio example (authentication disabled; replace the model ID exactly):
# AI_ENABLED=true
# AI_BASE_URL=http://127.0.0.1:1234/v1
# OPENAI_API_KEY=lm-studio
# AI_MODEL=EXACT_MODEL_ID_FROM_GET_V1_MODELS
# AI_TIMEOUT_SECONDS=120
# For authenticated servers use their real key locally, never in committed files.

# ------------------------------------------------------------------------------
# Source Catalog & Probe Configuration
# ------------------------------------------------------------------------------
SOURCE_CATALOG_PATH=data/turkish-job-sources.md
SOURCE_PROBE_TIMEOUT_SECONDS=10.0
SOURCE_PROBE_USER_AGENT=JobScope/0.1.0 (source-health-probe)

# Crawler safety limits: decoded bytes, physical attempts (including redirects/retries),
# and total network-acquisition seconds per Source. Source JSON cannot disable them.
CRAWLER_MAX_RESPONSE_BYTES=15728640
CRAWLER_MAX_SOURCE_REQUESTS=1000
CRAWLER_MAX_SOURCE_BYTES=134217728
CRAWLER_MAX_SOURCE_SECONDS=300

# ------------------------------------------------------------------------------
# Frontend Configuration (Optional; set in frontend/.env.local, not root .env)
# ------------------------------------------------------------------------------
# Candidate User ID override header (X-User-Id) for development/testing
# NEXT_PUBLIC_USER_ID=00000000-0000-0000-0000-000000000001
# Backend URL used by Next.js API route rewrites
# BACKEND_API_URL=http://127.0.0.1:8000
