# ==============================================================================
# JobScope Environment Configuration Template (.env.example)
#
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
#
# DO NOT store real production secrets or credentials in this file or commit .env!
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Application Settings
# ------------------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=true
APP_NAME=JobScope
APP_VERSION=0.1.0

# ------------------------------------------------------------------------------
# Server Network Binding
# ------------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000

# ------------------------------------------------------------------------------
# Database Configuration (PostgreSQL with asyncpg driver)
# ------------------------------------------------------------------------------
# Pattern: postgresql+asyncpg://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/<DB_NAME>
DATABASE_URL=postgresql+asyncpg://jobscope:jobscope@localhost:5432/jobscope

# Optional Docker Compose PostgreSQL container environment variables
POSTGRES_DB=jobscope
POSTGRES_USER=jobscope
POSTGRES_PASSWORD=jobscope
POSTGRES_PORT=5432

# ------------------------------------------------------------------------------
# Logging Configuration
# ------------------------------------------------------------------------------
# Verbosity: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
# Format: console (human-readable) or json (machine-readable structured logging)
LOG_FORMAT=console

# ------------------------------------------------------------------------------
# Source Catalog & Probe Configuration
# ------------------------------------------------------------------------------
SOURCE_CATALOG_PATH=data/turkish-job-sources.md
SOURCE_PROBE_TIMEOUT_SECONDS=10.0
SOURCE_PROBE_USER_AGENT=JobScope/0.1.0 (source-health-probe)

# ------------------------------------------------------------------------------
# Frontend Configuration (Optional)
# ------------------------------------------------------------------------------
# Candidate User ID override header (X-User-Id) for development/testing
# NEXT_PUBLIC_USER_ID=00000000-0000-0000-0000-000000000001
# Backend URL used by Next.js API route rewrites
# BACKEND_API_URL=http://127.0.0.1:8000
