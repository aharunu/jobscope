# ==============================================================================
# JobScope Environment Configuration
# ==============================================================================

# Application Environment (development, test, production)
ENVIRONMENT=development
DEBUG=true
APP_NAME=JobScope
APP_VERSION=0.1.0

# Server
HOST=127.0.0.1
PORT=8000

# Database Configuration (PostgreSQL with asyncpg driver)
DATABASE_URL=postgresql+asyncpg://jobscope:jobscope@localhost:5432/jobscope

# Logging (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO
