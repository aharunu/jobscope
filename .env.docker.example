# Optional isolated Compose configuration. Copy to ignored .env.docker, replace
# CHANGE_ME, then: docker compose --env-file .env.docker up --build
# Or: .\start.ps1 -EnvFile .env.docker
# Plain docker compose uses root .env; native DATABASE_URL is never forwarded.
POSTGRES_DB=jobscope
POSTGRES_USER=jobscope
POSTGRES_PASSWORD=CHANGE_ME
DOCKER_POSTGRES_PORT=5433

# AI is optional. Docker overrides are separate from native Windows settings.
DOCKER_AI_ENABLED=false
DOCKER_AI_BASE_URL=
DOCKER_OPENAI_API_KEY=
DOCKER_AI_MODEL=gpt-4.1-mini-2025-04-14
DOCKER_AI_TIMEOUT_SECONDS=120
# LM Studio stays on Windows. To enable, use its exact GET /v1/models ID:
# DOCKER_AI_ENABLED=true
# DOCKER_AI_BASE_URL=http://host.docker.internal:1234/v1
# DOCKER_OPENAI_API_KEY=lm-studio
# DOCKER_AI_MODEL=EXACT_MODEL_ID_FROM_GET_V1_MODELS
